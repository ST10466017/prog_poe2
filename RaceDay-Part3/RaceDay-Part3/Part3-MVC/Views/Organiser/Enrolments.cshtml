@model List<EnrolmentDto>
@{ViewData["Title"]="Event entries";}
<h1 class="fw-bold">Entries: @ViewBag.Event?.EventName</h1><div class="card p-3 table-responsive"><table class="table align-middle"><thead><tr><th>Participant</th><th>Category</th><th>Race no.</th><th>Enrolment</th><th>Result</th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.ParticipantName</td><td>@e.CategoryName</td><td>@e.RaceNumber</td><td><span class="badge @(e.Status=="Cancelled"?"bg-secondary":"bg-success")">@e.Status</span></td><td>@if(e.Status!="Cancelled"){<form asp-action="RecordResult" method="post" class="d-flex gap-1"><input type="hidden" name="EnrolmentId" value="@e.EnrolmentId"/><select name="Status" class="form-select form-select-sm"><option>Finished</option><option>DNF</option><option>DNS</option><option>Not Started</option></select><input name="FinishTime" class="form-control form-control-sm" placeholder="hh:mm:ss"/><input name="Position" type="number" min="1" class="form-control form-control-sm" placeholder="Place"/><button class="btn btn-sm btn-warning">Save</button></form>}</td></tr>}</tbody></table></div><h3 class="mt-5">Recorded results</h3><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Participant</th><th>Category</th><th>Position</th><th>Finish time</th><th>Correct result</th></tr></thead><tbody>@foreach(var r in (ViewBag.Results as List<ResultDto>??new())){<tr><td>@r.ParticipantName</td><td>@r.CategoryName</td><td>@(r.Position?.ToString()??"—")</td><td>@(r.FinishTime?.ToString(@"hh\:mm\:ss")??"—")</td><td><form asp-action="UpdateResult" asp-route-id="@r.ResultId" method="post" class="d-flex gap-1"><select name="Status" class="form-select form-select-sm"><option selected="@(r.Status=="Finished")">Finished</option><option selected="@(r.Status=="DNF")">DNF</option><option selected="@(r.Status=="DNS")">DNS</option><option selected="@(r.Status=="Not Started")">Not Started</option></select><input name="FinishTime" class="form-control form-control-sm" placeholder="hh:mm:ss" value="@r.FinishTime"/><input name="Position" type="number" class="form-control form-control-sm" placeholder="Place" value="@r.Position"/><button class="btn btn-sm btn-outline-dark">Update</button></form></td></tr>}</tbody></table></div>