@model List<EventDto>
@{ViewData["Title"]="Organiser dashboard";}
<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="fw-bold">Organiser dashboard</h1><p class="text-muted">Manage your events, entries and race-day results.</p></div><a asp-action="Create" class="btn btn-warning">＋ Create event</a></div>
<div class="table-responsive card p-3"><table class="table align-middle"><thead><tr><th>Event</th><th>Date</th><th>Location</th><th>Status</th><th>Manage</th></tr></thead><tbody>@foreach(var e in Model){<tr><td class="fw-semibold">@e.EventName</td><td>@e.EventDate.ToString("dd MMM yyyy")</td><td>@e.Location</td><td><span class="badge status-@e.Status.ToLowerInvariant()">@e.Status</span></td><td class="d-flex flex-wrap gap-2"><a class="btn btn-sm btn-outline-dark" asp-action="Edit" asp-route-id="@e.EventId">Edit</a><a class="btn btn-sm btn-outline-dark" asp-action="Categories" asp-route-id="@e.EventId">Categories</a><a class="btn btn-sm btn-outline-dark" asp-action="Enrolments" asp-route-id="@e.EventId">Entries/results</a><form asp-action="Delete" method="post"><input type="hidden" name="id" value="@e.EventId"/><button class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this event?')">Delete</button></form></td></tr>}</tbody></table></div>