@model List<CategoryDto>
@{ViewData["Title"]="Event categories";}
<h1 class="fw-bold">Categories: @ViewBag.Event?.EventName</h1><div class="card p-4 mb-4"><h4>Add a category</h4><form asp-action="AddCategory" method="post" class="row g-2"><input type="hidden" name="EventId" value="@ViewBag.EventId"/><div class="col-md-3"><input name="CategoryName" class="form-control" placeholder="e.g. 10km Open" required/></div><div class="col-md-2"><select name="CategoryType" class="form-select"><option>Distance</option><option>Age</option></select></div><div class="col-md-2"><input name="DistanceKm" type="number" step=".1" class="form-control" placeholder="Distance km"/></div><div class="col-md-2"><input name="EntryFee" type="number" step=".01" class="form-control" placeholder="Entry fee"/></div><div class="col-md-2"><input name="MaxParticipants" type="number" value="100" class="form-control" placeholder="Places"/></div><div class="col-md-1"><button class="btn btn-warning">Add</button></div></form></div><div class="card p-3"><table class="table"><thead><tr><th>Category</th><th>Type</th><th>Fee</th><th>Capacity</th><th></th></tr></thead><tbody>@foreach(var c in Model){<tr><td>@c.CategoryName</td><td>@c.CategoryType</td><td>R @c.EntryFee.ToString("N2")</td><td>@c.MaxParticipants</td><td><form asp-action="DeleteCategory" method="post"><input type="hidden" name="id" value="@c.CategoryId"/><input type="hidden" name="eventId" value="@c.EventId"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div>