@model EventVm
@{ViewData["Title"]=Model.EventId.HasValue?"Edit event":"Create event";}
<h1 class="fw-bold">@ViewData["Title"]</h1><div class="card p-4 form-card"><form method="post" enctype="multipart/form-data"><div asp-validation-summary="ModelOnly" class="text-danger"></div><input asp-for="EventId" type="hidden"/><div class="mb-3"><label asp-for="EventName" class="form-label"></label><input asp-for="EventName" class="form-control"/><span asp-validation-for="EventName" class="text-danger"></span></div><div class="mb-3"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="3"></textarea></div><div class="row"><div class="col-md-6 mb-3"><label asp-for="EventDate" class="form-label"></label><input asp-for="EventDate" type="date" class="form-control"/></div><div class="col-md-6 mb-3"><label asp-for="Location" class="form-label"></label><input asp-for="Location" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="DistanceKm" class="form-label">Distance (km)</label><input asp-for="DistanceKm" class="form-control"/></div><div class="col-md-4 mb-3"><label asp-for="EventType" class="form-label"></label><select asp-for="EventType" class="form-select"><option>Run</option><option>Walk</option><option>Cycle</option></select></div><div class="col-md-4 mb-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select"><option>Upcoming</option><option>Completed</option><option>Cancelled</option></select></div></div><div class="mb-3"><label asp-for="Banner" class="form-label">Event banner image</label><input asp-for="Banner" type="file" accept="image/*" class="form-control"/><small class="text-muted">JPG, PNG or WebP; max 5 MB. Stored by the API in Azure Blob Storage.</small></div><button class="btn btn-warning">Save event</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div>