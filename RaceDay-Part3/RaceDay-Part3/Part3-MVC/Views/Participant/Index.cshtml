@model List<EnrolmentDto>
@{ViewData["Title"]="My races";var results=ViewBag.Results as List<ResultDto>??new();}
<div class="d-flex justify-content-between"><div><h1 class="fw-bold">My race dashboard</h1><p class="text-muted">Your upcoming events and race history.</p></div><a asp-action="Profile" class="btn btn-outline-dark align-self-start">My profile</a></div><h3 class="mt-4">My enrolments</h3><div class="card p-3 table-responsive"><table class="table align-middle"><thead><tr><th>Event</th><th>Category</th><th>Race no.</th><th>Date joined</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in Model){<tr><td>@e.EventName</td><td>@e.CategoryName</td><td>@e.RaceNumber</td><td>@e.EnrolmentDate.ToString("dd MMM yyyy")</td><td><span class="badge @(e.Status=="Confirmed"?"bg-success":"bg-warning text-dark")">@e.Status</span></td><td>@if(e.Status!="Cancelled"){<form asp-action="Cancel" method="post"><input type="hidden" name="id" value="@e.EnrolmentId"/><button class="btn btn-sm btn-outline-danger">Cancel</button></form>}</td></tr>}</tbody></table></div><h3 class="mt-5">My results</h3><div class="card p-3 table-responsive"><table class="table"><thead><tr><th>Event</th><th>Category</th><th>Position</th><th>Finish time</th><th>Status</th></tr></thead><tbody>@foreach(var r in results){<tr><td>@r.EventName</td><td>@r.CategoryName</td><td>@(r.Position?.ToString()??"—")</td><td>@(r.FinishTime?.ToString(@"hh\:mm\:ss")??"—")</td><td>@r.Status</td></tr>}</tbody></table></div>