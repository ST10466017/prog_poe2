<!DOCTYPE html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><title>@ViewData["Title"] - RaceDay</title><link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet"/><link rel="stylesheet" href="~/css/site.css"/></head><body><nav class="navbar navbar-expand-lg navbar-dark bg-dark"><div class="container"><a class="navbar-brand fw-bold" asp-controller="Home" asp-action="Index">🏁 RaceDay</a><button class="navbar-toggler" data-bs-toggle="collapse" data-bs-target="#nav"><span class="navbar-toggler-icon"></span></button><div id="nav" class="collapse navbar-collapse"><div class="navbar-nav me-auto"><a class="nav-link" asp-controller="Home" asp-action="Index">Events</a>@if(User.IsInRole("Organiser")){<a class="nav-link" asp-controller="Organiser" asp-action="Index">Organiser dashboard</a>}@if(User.IsInRole("Participant")){<a class="nav-link" asp-controller="Participant" asp-action="Index">My races</a>}</div><div class="navbar-nav">@if(User.Identity?.IsAuthenticated==true){<span class="navbar-text me-3">Hi, @User.Identity.Name</span><form asp-controller="Account" asp-action="Logout" method="post"><button class="btn btn-outline-light btn-sm">Log out</button></form>}else{<a class="nav-link" asp-controller="Account" asp-action="Login">Sign in</a><a class="nav-link" asp-controller="Account" asp-action="Register">Register</a>}</div></div></div></nav><main class="container py-4">@if(TempData["Success"]!=null){<div class="alert alert-success">@TempData["Success"]</div>}@if(TempData["Error"]!=null){<div class="alert alert-danger">@TempData["Error"]</div>}@RenderBody()</main><footer class="text-center py-4 text-muted">© @DateTime.Now.Year RaceDay · Run together. Go further.</footer><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>@await RenderSectionAsync("Scripts",required:false)</body></html>