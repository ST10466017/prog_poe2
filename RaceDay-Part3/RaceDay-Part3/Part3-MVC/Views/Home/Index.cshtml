@model List<EventDto>
@{ViewData["Title"]="Upcoming events";}
<section class="hero p-5 rounded-4 mb-4 text-white"><span class="badge bg-warning text-dark mb-2">FIND YOUR NEXT FINISH LINE</span><h1 class="display-4 fw-bold">Move more.<br/>Go further.</h1><p class="lead">Discover races, walks and cycling events in your community.</p><a class="btn btn-warning btn-lg" href="#events">Explore events</a></section>
<div class="d-flex flex-wrap justify-content-between align-items-center mb-3" id="events"><div><h2 class="fw-bold mb-0">Upcoming events</h2><p class="text-muted">Choose your next challenge.</p></div><form method="get" class="d-flex gap-2"><select class="form-select" name="eventType"><option value="">All event types</option>@foreach(var t in new[]{"Run","Walk","Cycle"}){<option selected="@(ViewBag.EventType==t)" value="@t">@t</option>}</select><button class="btn btn-dark">Filter</button></form></div>
@if(ViewBag.Error!=null){<div class="alert alert-warning">@ViewBag.Error</div>}
<div class="row g-4">@foreach(var e in Model){<div class="col-md-6 col-lg-4"><div class="card event-card h-100 shadow-sm">@if(!string.IsNullOrWhiteSpace(e.BannerImageUrl)){<img src="@e.BannerImageUrl" class="card-img-top event-banner" alt="Banner for @e.EventName"/>}else{<div class="event-placeholder">🏃</div>}<div class="card-body"><div class="d-flex justify-content-between"><span class="badge text-bg-primary">@e.EventType</span><span class="badge status-@e.Status.ToLowerInvariant()">@e.Status</span></div><h5 class="card-title mt-3 fw-bold">@e.EventName</h5><p class="text-muted mb-2">📅 @e.EventDate.ToString("dd MMM yyyy")</p><p class="text-muted">📍 @e.Location · @e.DistanceKm km</p><p>@e.Description</p><a asp-action="Details" asp-route-id="@e.EventId" class="btn btn-dark">View event</a></div></div></div>}</div>
@if(Model.Count==0){<div class="text-center p-5 bg-light rounded-4"><h4>No events found</h4><p class="text-muted">Try another filter or check back soon.</p></div>}