@model EventDto
@{ViewData["Title"]=Model?.EventName??"Event";var cats=ViewBag.Categories as List<CategoryDto>??new();var results=ViewBag.Results as List<ResultDto>??new();}
@if(Model==null){<div class="alert alert-warning">Event not found.</div>}else{<a asp-action="Index" class="text-decoration-none">← All events</a><div class="hero p-4 rounded-4 text-white my-3"><span class="badge bg-warning text-dark">@Model.EventType</span><h1 class="display-5 fw-bold mt-2">@Model.EventName</h1><p>@Model.EventDate.ToString("dddd, dd MMMM yyyy") · @Model.Location · @Model.DistanceKm km</p><p>@Model.Description</p></div><h3>Categories & enrolment</h3><div class="row g-3">@foreach(var c in cats){<div class="col-md-6"><div class="card p-3 h-100"><h5>@c.CategoryName</h5><p class="text-muted">@c.CategoryType · @c.MaxParticipants places · R @c.EntryFee.ToString("N2")</p>@if(User.IsInRole("Participant")){<form asp-controller="Participant" asp-action="Enrol" method="post"><input type="hidden" name="categoryId" value="@c.CategoryId"/><select class="form-select mb-2" name="paymentMethod"><option>EFT</option><option>Card</option><option>Cash</option></select><button class="btn btn-warning">Enrol now</button></form>}else if(!User.Identity!.IsAuthenticated){<a asp-controller="Account" asp-action="Login" class="btn btn-outline-dark">Sign in to enrol</a>}</div></div>}</div><h3 class="mt-5">Leaderboard</h3><div class="table-responsive"><table class="table table-striped"><thead><tr><th>Position</th><th>Participant</th><th>Category</th><th>Race no.</th><th>Finish time</th><th>Status</th></tr></thead><tbody>@foreach(var r in results){<tr><td>@(r.Position?.ToString()??"—")</td><td>@r.ParticipantName</td><td>@r.CategoryName</td><td>@r.RaceNumber</td><td>@(r.FinishTime?.ToString(@"hh\:mm\:ss")??"—")</td><td>@r.Status</td></tr>}</tbody></table></div>}